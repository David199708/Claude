---
// Behandlungsübersicht als Reiter. Die aktive Markierung ist eine geclippte Kopie der Reiterleiste,
// so wechseln Hintergrund und Schriftfarbe exakt gleichzeitig.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { studio, categories, extraNote } from '../data/site';
import gesicht from '../assets/stock/gesicht.jpg';
import haende from '../assets/stock/haende.jpg';
import pflege from '../assets/stock/pflege.jpg';
import massage from '../assets/stock/massage.jpg';

// Stimmungsfotos je Bereich (Unsplash-Lizenz, siehe src/assets/stock/QUELLEN.md)
const photos: Record<string, ImageMetadata> = { serum: gesicht, polish: haende, leaf: pflege, stones: massage };

const pad = (n: number) => String(n + 1).padStart(2, '0');
---

<div class="treatments" data-treatments>
  <div class="tabs reveal" role="tablist" aria-label="Behandlungsbereiche" data-tablist>
    {categories.map((c, i) => (
      <button
        class="tab"
        role="tab"
        id={`tab-${i}`}
        aria-controls={`panel-${i}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        data-tab={i}
      >
        <span class="tab-accent">{c.accent}</span>
        <span class="tab-title">{c.title}</span>
      </button>
    ))}
    <div class="tabs-active" aria-hidden="true" data-active-copy>
      {categories.map((c) => (
        <span class="tab">
          <span class="tab-accent">{c.accent}</span>
          <span class="tab-title">{c.title}</span>
        </span>
      ))}
    </div>
  </div>

  <div class="panels reveal" style="--delay: 80ms">
    {categories.map((c, i) => (
      <section class="panel" role="tabpanel" id={`panel-${i}`} aria-labelledby={`tab-${i}`} data-panel={i}>
        <div class="panel-intro">
          <figure class="photo">
            <Image src={photos[c.icon]} alt="" widths={[480, 800]} sizes="(min-width: 900px) 360px, 90vw" loading="eager" />
          </figure>
          <p class="panel-accent" aria-hidden="true">{c.accent}</p>
          <h3>{c.title}</h3>
          <p class="panel-text">{c.intro}</p>
          <p class="panel-count">{c.items.length} Behandlungen</p>
        </div>
        <ol class:list={['list', { two: c.items.length > 5 }]}>
          {c.items.map((t, j) => (
            <li style={`--n: ${j}`}>
              <span class="num">{pad(j)}</span>
              <span class="name">{t.name}</span>
              {t.price && <span class="price">{t.price}</span>}
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>

  <div class="after reveal">
    <p class="extra">{extraNote}</p>
    <a href={studio.phoneHref} class="btn btn-primary">Behandlung anfragen</a>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-treatments]').forEach((root) => {
    const tablist = root.querySelector<HTMLElement>('[data-tablist]')!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const copy = root.querySelector<HTMLElement>('[data-active-copy]')!;
    let current = 0;

    const clipTo = (i: number) => {
      const t = tabs[i];
      const w = tablist.clientWidth;
      const h = tablist.clientHeight;
      const top = t.offsetTop;
      const left = t.offsetLeft;
      copy.style.clipPath = `inset(${top}px ${w - left - t.offsetWidth}px ${h - top - t.offsetHeight}px ${left}px round 999px)`;
    };

    // Tastatur-Wechsel ohne Animation – wer mit Pfeiltasten springt, soll nicht warten.
    const activate = (i: number, instant: boolean) => {
      root.toggleAttribute('data-instant', instant);
      tabs.forEach((t, j) => {
        t.setAttribute('aria-selected', String(i === j));
        t.tabIndex = i === j ? 0 : -1;
      });
      panels.forEach((p, j) => (p.hidden = i !== j));
      clipTo(i);
      current = i;
    };

    tabs.forEach((t, i) => {
      t.addEventListener('click', (e) => {
        if (i !== current) activate(i, (e as MouseEvent).detail === 0);
      });
      t.addEventListener('keydown', (e) => {
        const dir = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!dir) return;
        e.preventDefault();
        const next = (current + dir + tabs.length) % tabs.length;
        activate(next, true);
        tabs[next].focus();
      });
    });

    root.classList.add('is-ready');
    activate(0, true);
    new ResizeObserver(() => clipTo(current)).observe(tablist);
  });
</script>

<style>
  /* Reiterleiste */
  .tabs {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 6px;
    padding: 6px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 28px;
    margin-bottom: 20px;
  }

  @media (min-width: 760px) {
    .tabs {
      grid-template-columns: repeat(4, 1fr);
      border-radius: 999px;
    }
  }

  .tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 12px 8px 14px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font: inherit;
    cursor: pointer;
    transition: transform 160ms var(--ease-out);
    -webkit-tap-highlight-color: transparent;
  }

  button.tab:active {
    transform: scale(0.97);
  }

  button.tab:focus-visible {
    outline: 2px solid var(--sage-dark);
    outline-offset: 2px;
  }

  .tab-accent {
    font-family: 'Allura', cursive;
    font-size: 30px;
    line-height: 1;
    color: var(--sage-dark);
  }

  .tab-title {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    text-align: center;
  }

  /* Aktive Kopie: liegt deckungsgleich darüber und wird auf den aktiven Reiter zugeschnitten */
  .tabs-active {
    display: none;
  }

  .is-ready .tabs-active {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: inherit;
    gap: inherit;
    padding: inherit;
    pointer-events: none;
    clip-path: inset(6px 75% 6px 6px round 999px);
    transition: clip-path 250ms var(--ease-in-out);
  }

  [data-instant] .tabs-active {
    transition: none;
  }

  /* Hintergrund auf der ganzen Kopie: der Zuschnitt allein formt die Pille, auch mitten im Gleiten */
  .is-ready .tabs-active {
    background: var(--sage-dark);
    border-radius: inherit;
  }

  .tabs-active .tab {
    cursor: default;
  }

  .tabs-active .tab-accent {
    color: #fff;
  }

  .tabs-active .tab-title {
    color: rgba(255, 255, 255, 0.78);
  }

  @media (hover: hover) and (pointer: fine) {
    button.tab:hover .tab-title {
      color: var(--ink);
    }
  }

  /* Inhalt */
  .panels {
    display: grid;
    gap: 20px;
  }

  .panel {
    display: grid;
    gap: 28px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 6px);
    padding: clamp(24px, 4vw, 48px);
  }

  .panel[hidden] {
    display: none;
  }

  @media (min-width: 900px) {
    .panel {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 56px;
      min-height: 420px;
    }
  }

  .panel-intro {
    position: relative;
  }

  /* Foto deckt sich beim Öffnen eines Bereichs von unten auf und setzt sich dabei leicht */
  .photo {
    margin: 0 0 20px;
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    transition: clip-path 300ms var(--ease-out);
    clip-path: inset(0 0 0 0 round var(--radius));
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms var(--ease-out);
  }

  .is-ready .panel:not([hidden]) .photo {
    @starting-style {
      clip-path: inset(100% 0 0 0 round var(--radius));
    }
  }

  .is-ready .panel:not([hidden]) .photo :global(img) {
    @starting-style {
      transform: scale(1.08);
    }
  }

  .panel-accent {
    font-family: 'Allura', cursive;
    font-size: clamp(48px, 7vw, 72px);
    line-height: 0.9;
    color: var(--sage);
    margin-bottom: 2px;
  }

  .panel h3 {
    font-size: clamp(30px, 4vw, 40px);
  }

  .panel-text {
    color: var(--muted);
    margin-top: 10px;
  }

  .panel-count {
    margin-top: 20px;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sage-dark);
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    align-self: center;
  }

  @media (min-width: 640px) {
    .list.two {
      columns: 2;
      column-gap: 32px;
    }
  }

  .list li {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    break-inside: avoid;
    transition:
      opacity 200ms var(--ease-out),
      transform 200ms var(--ease-out);
    transition-delay: calc(var(--n) * 30ms);
  }

  /* Zeilen erscheinen nacheinander, wenn ein Bereich geöffnet wird */
  .is-ready .panel:not([hidden]) .list li {
    @starting-style {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  /* Überschrift des Bereichs kommt mit derselben Bewegung wie die Zeilen */
  .panel-intro > :not(.photo) {
    transition:
      opacity 200ms var(--ease-out),
      transform 200ms var(--ease-out);
  }

  .is-ready .panel:not([hidden]) .panel-intro > :not(.photo) {
    @starting-style {
      opacity: 0;
      transform: translateY(4px);
    }
  }

  [data-instant] .list li,
  [data-instant] .photo,
  [data-instant] .photo :global(img),
  [data-instant] .panel-intro > * {
    transition: none;
  }

  .num {
    font-family: var(--serif);
    font-style: italic;
    font-size: 18px;
    color: var(--sage-dark);
    min-width: 1.6em;
    font-variant-numeric: tabular-nums;
  }

  .name {
    font-size: 16px;
    flex: 1;
  }

  .price {
    color: var(--sage-dark);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .after {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    margin-top: 32px;
    text-align: center;
  }

  .extra {
    color: var(--muted);
    font-family: var(--serif);
    font-style: italic;
    font-size: 21px;
  }

  @media (prefers-reduced-motion: reduce) {
    .is-ready .tabs-active,
    .list li {
      transition-property: opacity;
    }
    /* Weniger Bewegung: Foto blendet weich ein, ohne Aufdecken und Zoom */
    .photo {
      clip-path: none;
      transition: opacity 200ms ease;
    }
    .photo :global(img) {
      transition: none;
    }
    .is-ready .panel:not([hidden]) .photo {
      @starting-style {
        clip-path: none;
        opacity: 0;
      }
    }
    .is-ready .panel:not([hidden]) .photo :global(img) {
      @starting-style {
        transform: none;
      }
    }
    .is-ready .panel:not([hidden]) .list li,
    .is-ready .panel:not([hidden]) .panel-intro > :not(.photo) {
      @starting-style {
        transform: none;
      }
    }
  }
</style>
