---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { studio } from '../data/site';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<Base title={`${title} – ${studio.name}`}>
  <Header />
  <main class="container legal">
    <h1>{title}</h1>
    <slot />
  </main>
  <Footer />
</Base>

<style>
  .legal {
    max-width: 760px;
    padding-top: 64px;
    padding-bottom: 96px;
  }

  h1 {
    font-size: clamp(40px, 6vw, 56px);
    margin-bottom: 32px;
  }

  .legal :global(h2) {
    font-size: 28px;
    margin: 40px 0 8px;
  }

  .legal :global(p) {
    color: var(--muted);
    margin-top: 8px;
  }

  .legal :global(mark) {
    background: #fff3c4;
    color: var(--ink);
  }
</style>
