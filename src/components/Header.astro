---
import fs from 'node:fs';
import path from 'node:path';
import { studio } from '../data/site';

// Sobald public/logo.png existiert, wird das Logo statt des Schriftzugs gezeigt.
const hasLogo = fs.existsSync(path.join(process.cwd(), 'public/logo.png'));
---

<header class="header" data-header>
  <div class="container inner">
    <a href="/" class="logo" aria-label={`${studio.name} – Startseite`}>
      {hasLogo ? (
        <img src="/logo.png" alt={studio.name} class="logo-img" height="52" />
      ) : (
        <>
          <span class="logo-small">Kosmetik</span>
          <span class="logo-main">im Gutshaus</span>
        </>
      )}
    </a>
    <nav aria-label="Hauptnavigation">
      <a href="/#behandlungen">Behandlungen</a>
      <a href="/#gutshaus">Das Gutshaus</a>
      <a href="/#ueber-mich">Über mich</a>
      <a href="/#kontakt">Kontakt</a>
    </nav>
    <a href={studio.phoneHref} class="btn btn-primary call">Anrufen</a>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const update = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--paper) 85%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
    padding-top: env(safe-area-inset-top);
  }

  /* Schatten erscheint erst, wenn Inhalt unter der Kopfzeile liegt */
  .header::after {
    content: '';
    position: absolute;
    inset: 100% 0 auto;
    height: 16px;
    background: linear-gradient(rgba(47, 42, 37, 0.06), transparent);
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms ease;
  }

  .header[data-scrolled]::after {
    opacity: 1;
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: var(--header-h);
  }

  .logo {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    line-height: 1;
  }

  .logo-img {
    height: 44px;
    width: auto;
  }

  .logo-small {
    font-size: 10px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .logo-main {
    font-family: var(--serif);
    font-size: 24px;
    margin-top: 4px;
  }

  nav {
    display: none;
    gap: 32px;
    font-size: 15px;
  }

  nav a {
    position: relative;
    text-decoration: none;
    color: var(--muted);
    transition: color 200ms ease;
  }

  /* Unterstreichung wächst von links */
  nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0.001);
    transform-origin: left;
    transition: transform 200ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    nav a:hover {
      color: var(--ink);
    }
    nav a:hover::after {
      transform: scaleX(1);
    }
  }

  /* Weniger Bewegung: Unterstreichung blendet ein statt zu wachsen */
  @media (prefers-reduced-motion: reduce) {
    nav a::after {
      transform: none;
      opacity: 0;
      transition: opacity 200ms ease;
    }
    @media (hover: hover) and (pointer: fine) {
      nav a:hover::after {
        transform: none;
        opacity: 1;
      }
    }
  }

  .call {
    min-height: 44px;
    padding: 0 18px;
    font-size: 14px;
  }

  @media (min-width: 760px) {
    nav {
      display: flex;
    }
    .logo-img {
      height: 60px;
    }
  }
</style>
