---
// Scroll-Fahrt: vom Gutshaus von außen hinein in den Behandlungsraum und zur Sitzecke.
// Innenfotos werden automatisch verwendet, sobald sie als src/assets/innen-1.* und innen-2.* existieren.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import gutshaus from '../assets/gutshaus.webp';
import { studio } from '../data/site';

const found = import.meta.glob<{ default: ImageMetadata }>('../assets/innen-*.{jpg,jpeg,png,webp}', { eager: true });
const interior = (n: number) => Object.entries(found).find(([p]) => p.includes(`innen-${n}.`))?.[1].default;

const scenes = [
  {
    eyebrow: 'Das Gutshaus',
    title: 'Ein besonderer Ort für Ihre Auszeit.',
    text: `Mein Studio liegt im Gutshaus in der ${studio.street} – einem Haus aus rotem Sandstein mit grünen Fensterläden.`,
  },
  {
    eyebrow: 'Treten Sie ein',
    title: 'Ihr Behandlungsraum.',
    text: `Hell, warm und ruhig – mit hochwertiger Pflege von ${studio.brand}.`,
    image: interior(1),
    placeholder: 'Behandlungsraum',
    alt: 'Der Behandlungsraum mit Behandlungsliege und Holzschrank',
  },
  {
    eyebrow: 'Ankommen',
    title: 'Zeit für ein Gespräch.',
    text: 'Jede Behandlung beginnt in Ruhe – in der gemütlichen Sitzecke.',
    image: interior(2),
    placeholder: 'Sitzecke',
    alt: 'Die Sitzecke mit kleinem Holztisch, Kerze und zwei Stühlen',
  },
];
---

<section id="gutshaus" class="tour" data-tour>
  <div class="sticky">
    <div class="frame" data-frame>
      <div class="layer layer-1" data-layer="1">
        {scenes[1].image ? (
          <Image src={scenes[1].image} alt={scenes[1].alt} widths={[640, 1280]} sizes="100vw" loading="lazy" />
        ) : (
          <div class="placeholder"><span>Innenfoto folgt: {scenes[1].placeholder}</span></div>
        )}
      </div>
      <div class="layer layer-0" data-layer="0">
        <Image
          src={gutshaus}
          alt="Das Gutshaus in der Hofstraße in Altenhaßlau: rotes Sandsteinhaus mit petrolfarbenen Fensterläden"
          widths={[480, 640]}
          sizes="100vw"
          loading="lazy"
        />
      </div>
      <div class="layer layer-2" data-layer="2">
        {scenes[2].image ? (
          <Image src={scenes[2].image} alt={scenes[2].alt} widths={[640, 1280]} sizes="100vw" loading="lazy" />
        ) : (
          <div class="placeholder alt"><span>Innenfoto folgt: {scenes[2].placeholder}</span></div>
        )}
      </div>
      <div class="scrim" aria-hidden="true"></div>

      {scenes.map((s, i) => (
        <div class="caption" data-caption={i}>
          <p class="eyebrow">{s.eyebrow}</p>
          <h2>{s.title}</h2>
          <p class="text">{s.text}</p>
        </div>
      ))}

      <ol class="steps" aria-hidden="true">
        {scenes.map((_, i) => <li data-step={i} data-active={i === 0 ? '' : undefined} />)}
      </ol>
    </div>
  </div>
</section>

<script>
  const tour = document.querySelector<HTMLElement>('[data-tour]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (tour) {
    const frame = tour.querySelector<HTMLElement>('[data-frame]')!;
    const sticky = frame.parentElement!;
    const layers = [...tour.querySelectorAll<HTMLElement>('[data-layer]')].sort(
      (a, b) => Number(a.dataset.layer) - Number(b.dataset.layer),
    );
    const imgs = layers.map((l) => l.firstElementChild as HTMLElement);
    const captions = [...tour.querySelectorAll<HTMLElement>('[data-caption]')];
    const steps = [...tour.querySelectorAll<HTMLElement>('[data-step]')];

    // Geometrie ändert sich nur bei Größenänderung – nicht pro Scroll-Bild neu messen
    let stickTop = 0, total = 1, gx = 16, gy = 0;
    const measure = () => {
      stickTop = parseFloat(getComputedStyle(sticky).top);
      total = tour.offsetHeight - sticky.offsetHeight;
      const vw = window.innerWidth;
      gx = vw >= 1216 ? (vw - 1120) / 2 : Math.min(48, Math.max(16, vw * 0.05));
      gy = frame.offsetHeight * 0.07;
    };

    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    const seg = (p: number, a: number, b: number) => clamp((p - a) / (b - a));
    // Starkes Ease-in-out, passend zu --ease-in-out
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    const fadeIn = (p: number, a: number, b: number) => ease(seg(p, a, b));

    // Sichtbarkeit einer Bildunterschrift: einblenden, halten, ausblenden
    const showCaption = (el: HTMLElement, v: number, out = 0) => {
      const o = v * (1 - out);
      el.style.opacity = String(o);
      el.style.transform = `translateY(${(1 - v) * 16 - out * 16}px)`;
      el.style.visibility = o < 0.01 ? 'hidden' : 'visible';
    };

    let frameReq = 0;
    const render = () => {
      frameReq = 0;
      // Fortschritt der Phase, in der die Bühne unter der Kopfzeile klebt (0 bis 1)
      const p = clamp((stickTop - tour.getBoundingClientRect().top) / total);

      // 1) Karte wächst zum Vollbild
      const grow = ease(seg(p, 0, 0.14));
      frame.style.clipPath = `inset(${gy * (1 - grow)}px ${gx * (1 - grow)}px ${gy * (1 - grow)}px ${gx * (1 - grow)}px round ${20 * (1 - grow)}px)`;

      // 2) Zoom auf den Eingang, dann Überblenden nach innen (Unschärfe kaschiert den Übergang)
      const zoom = ease(seg(p, 0.1, 0.34));
      const out0 = seg(p, 0.28, 0.38);
      imgs[0].style.transform = `scale(${1 + 0.1 * grow + 0.5 * zoom})`;
      layers[0].style.opacity = String(1 - out0);
      imgs[0].style.filter = out0 > 0 && out0 < 1 ? `blur(${out0 * 2}px)` : '';

      // 3) Behandlungsraum: kommt leicht vergrößert herein und setzt sich
      imgs[1].style.transform = `scale(${1.15 - 0.15 * ease(seg(p, 0.28, 0.58))})`;

      // 4) Sitzecke blendet über den Behandlungsraum
      const in2 = seg(p, 0.66, 0.76);
      layers[2].style.opacity = String(in2);
      imgs[2].style.transform = `scale(${1.1 - 0.1 * ease(seg(p, 0.66, 0.98))})`;

      showCaption(captions[0], 1, fadeIn(p, 0.06, 0.14));
      showCaption(captions[1], fadeIn(p, 0.38, 0.46), fadeIn(p, 0.6, 0.66));
      showCaption(captions[2], fadeIn(p, 0.76, 0.84));

      const active = p < 0.33 ? 0 : p < 0.71 ? 1 : 2;
      steps.forEach((s, i) => s.toggleAttribute('data-active', i === active));
    };

    const schedule = () => {
      if (!frameReq) frameReq = requestAnimationFrame(render);
    };
    const onResize = () => {
      measure();
      schedule();
    };

    const start = () => {
      tour.classList.add('is-live');
      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', onResize);
      measure();
      render();
    };

    // „Bewegung reduzieren“ kann während des Besuchs umgeschaltet werden: dann zurück zur statischen Bildfolge
    const stop = () => {
      cancelAnimationFrame(frameReq);
      frameReq = 0;
      window.removeEventListener('scroll', schedule);
      window.removeEventListener('resize', onResize);
      tour.classList.remove('is-live');
      [frame, ...layers, ...imgs, ...captions].forEach((el) => el.removeAttribute('style'));
    };

    if (!reduce.matches) start();
    reduce.addEventListener('change', () => (reduce.matches ? stop() : start()));
  }
</script>

<style>
  /* Grundzustand ohne JavaScript oder bei „Bewegung reduzieren“: Bilder untereinander */
  .tour {
    padding: clamp(64px, 10vw, 120px) 0;
  }

  .sticky {
    width: 100%;
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .frame {
    display: grid;
    gap: 24px;
  }

  .layer {
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  /* Reihenfolge im Grundzustand: Bild, Text, Bild, Text, Bild, Text */
  .layer-0 { order: 0; }
  [data-caption='0'] { order: 1; }
  .layer-1 { order: 2; }
  [data-caption='1'] { order: 3; }
  .layer-2 { order: 4; }
  [data-caption='2'] { order: 5; }

  .caption {
    margin-bottom: 32px;
  }

  .layer :global(img),
  .placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .placeholder {
    display: grid;
    place-items: center;
    background:
      radial-gradient(80% 60% at 30% 30%, rgba(255, 255, 255, 0.5), transparent),
      linear-gradient(160deg, #e9d6c2, #cdb39a);
    color: rgba(47, 42, 37, 0.6);
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(20px, 3vw, 30px);
  }

  .placeholder.alt {
    background:
      radial-gradient(80% 60% at 70% 30%, rgba(255, 255, 255, 0.45), transparent),
      linear-gradient(200deg, #d9c8b4, #b59c84);
  }

  .scrim,
  .steps {
    display: none;
  }

  .caption .eyebrow {
    color: var(--sage-dark);
  }

  .caption h2 {
    font-size: clamp(32px, 5vw, 56px);
    margin: 10px 0 12px;
  }

  .caption .text {
    color: var(--muted);
    max-width: 30em;
  }

  /* Live-Modus: Bühne bleibt stehen, während man scrollt */
  .tour.is-live {
    height: 300vh;
    padding: 0;
  }

  .is-live .sticky {
    position: sticky;
    top: 76px;
    height: calc(100svh - 76px);
    max-width: none;
    padding: 0;
  }

  .is-live .frame {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    background: #2a2622;
  }

  .is-live .layer {
    position: absolute;
    inset: 0;
    border-radius: 0;
    aspect-ratio: auto;
  }

  .is-live .layer-0 {
    z-index: 2;
  }
  .is-live .layer-1 {
    z-index: 1;
  }
  .is-live .layer-2 {
    z-index: 3;
    opacity: 0;
  }

  .is-live .layer-0 :global(img) {
    /* Zoom-Ziel: der Eingang des Gutshauses */
    transform-origin: 74% 84%;
  }

  .is-live .scrim {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
    background: linear-gradient(to top, rgba(28, 24, 20, 0.72), rgba(28, 24, 20, 0.15) 45%, transparent 70%);
  }

  .is-live .caption {
    position: absolute;
    z-index: 5;
    left: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    right: var(--gutter);
    bottom: clamp(40px, 9vh, 96px);
    color: #fff;
    max-width: 640px;
  }

  .is-live .caption + .caption {
    opacity: 0;
    visibility: hidden;
  }

  .is-live .caption .eyebrow {
    color: #bfe6d3;
  }

  .is-live .caption .text {
    color: rgba(255, 255, 255, 0.85);
    font-size: 18px;
  }

  .is-live .steps {
    display: flex;
    flex-direction: column;
    gap: 8px;
    position: absolute;
    z-index: 5;
    right: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    top: 50%;
    transform: translateY(-50%);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .steps li {
    width: 3px;
    height: 28px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.9);
    opacity: 0.35;
    transform: scaleY(0.6);
    transition:
      opacity 250ms ease,
      transform 250ms var(--ease-out);
  }

  .steps li[data-active] {
    opacity: 1;
    transform: none;
  }
</style>
