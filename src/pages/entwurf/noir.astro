---
// Entwurf 2 · Noir — Kino-Stil: ganzseitiges Startbild, Textzeilen steigen aus einer Maske,
// Behandlungen als waagerechtes Wisch-Karussell mit Fortschrittsbalken. Schwarz und Gold.
import { Image } from 'astro:assets';
import Draft from '../../layouts/Draft.astro';
import { studio, categories, extraNote } from '../../data/site';
import haus from '../../assets/gutshaus.webp';
import raum from '../../assets/innen-1.png';
import ecke from '../../assets/innen-2.png';
import gesicht from '../../assets/stock/gesicht.jpg';
import haende from '../../assets/stock/haende.jpg';
import pflege from '../../assets/stock/pflege.jpg';
import massage from '../../assets/stock/massage.jpg';
import band from '../../assets/stock/band.jpg';
import '@fontsource/playfair-display/latin-400.css';
import '@fontsource/playfair-display/latin-400-italic.css';
import '@fontsource/montserrat/latin-400.css';
import '@fontsource/montserrat/latin-500.css';

const photos = [gesicht, haende, pflege, massage];
---

<Draft title="Noir" theme="#0b0b0b">
  <header class="n-nav">
    <a href="#start"><img src="/logo.png" alt={studio.name} class="n-logo" /></a>
    <a class="n-btn ghost small" href={studio.phoneHref}>Anrufen</a>
  </header>

  <main id="start">
    <section class="n-hero">
      <Image src={haus} alt="Das Gutshaus in der Hofstraße" class="n-hero-img" widths={[640]} sizes="100vw" loading="eager" />
      <div class="n-hero-text">
        <p class="n-caps n-rise" style="--d:0"><span>Kosmetik im Gutshaus · Altenhaßlau</span></p>
        <h1>
          <span class="n-line"><span style="--d:1">Wohlfühl­stunden</span></span>
          <span class="n-line"><span style="--d:2"><em>für Körper und Sinne</em></span></span>
        </h1>
        <span class="n-rule" aria-hidden="true"></span>
        <div class="n-actions n-rise" style="--d:4"><span>
          <a class="n-btn" href={studio.phoneHref}>Termin vereinbaren</a>
          <a class="n-btn ghost" href="#behandlungen">Behandlungen</a>
        </span></div>
      </div>
    </section>

    <section class="n-sec" id="behandlungen">
      <div class="n-head">
        <p class="n-caps">Das Programm</p>
        <h2 class="n-mask" data-in><span>Vier Wege zur Ruhe.</span></h2>
      </div>
      <div class="n-rail" data-rail tabindex="0" aria-label="Behandlungsbereiche, seitlich wischen">
        {categories.map((c, i) => (
          <article class="n-card">
            <Image src={photos[i]} alt="" widths={[480, 800]} sizes="(min-width: 900px) 420px, 82vw" loading="lazy" />
            <div class="n-card-body">
              <p class="n-num">{String(i + 1).padStart(2, '0')}</p>
              <h3><em>{c.accent}</em><span>{c.title}</span></h3>
              <ul>{c.items.map((t) => <li>{t.name}</li>)}</ul>
            </div>
          </article>
        ))}
      </div>
      <div class="n-rail-foot">
        <span class="n-progress" aria-hidden="true"><span data-progress></span></span>
        <span class="n-arrows">
          <button class="n-arrow" data-dir="-1" aria-label="Zurück">←</button>
          <button class="n-arrow" data-dir="1" aria-label="Weiter">→</button>
        </span>
      </div>
      <p class="n-note">{extraNote}</p>
    </section>

    <section class="n-sec n-house" id="haus">
      <div class="n-head">
        <p class="n-caps">Das Gutshaus</p>
        <h2 class="n-mask" data-in><span>Ein Haus mit Geschichte.</span></h2>
      </div>
      <div class="n-gallery">
        <figure class="n-wipe a" data-in><Image src={haus} alt="Das Gutshaus" widths={[640]} sizes="(min-width: 900px) 60vw, 100vw" loading="lazy" /><figcaption>Hofstraße 2</figcaption></figure>
        <figure class="n-wipe b" data-in style="--d:1"><Image src={raum} alt="Der Behandlungsraum" widths={[640]} sizes="(min-width: 900px) 35vw, 100vw" loading="lazy" /><figcaption>Der Behandlungsraum</figcaption></figure>
        <figure class="n-wipe c" data-in style="--d:2"><Image src={ecke} alt="Die Sitzecke" widths={[640]} sizes="(min-width: 900px) 35vw, 100vw" loading="lazy" /><figcaption>Die Sitzecke</figcaption></figure>
      </div>
    </section>

    <section class="n-quote">
      <Image src={band} alt="" class="n-quote-bg" widths={[1400]} sizes="100vw" loading="lazy" />
      <blockquote class="n-mask" data-in><span>„Keine Fließbandtermine. Nur Zeit für Sie.“</span></blockquote>
      <p class="n-caps">{studio.owner}</p>
    </section>

    <section class="n-contact" id="kontakt">
      <p class="n-caps">{studio.hours}</p>
      <a class="n-phone" href={studio.phoneHref}>{studio.phone}</a>
      <p class="n-addr">{studio.street} · {studio.zip} {studio.city}</p>
      <a class="n-btn ghost" href={studio.mapsUrl} target="_blank" rel="noopener">Route planen</a>
      <p class="n-legal"><a href="/impressum">Impressum</a><a href="/datenschutz">Datenschutz</a></p>
    </section>
  </main>

  <script>
    // Karussell: Fortschrittsbalken folgt der Wischposition, Pfeile springen eine Karte weiter
    const rail = document.querySelector<HTMLElement>('[data-rail]')!;
    const bar = document.querySelector<HTMLElement>('[data-progress]')!;
    const update = () => {
      const max = rail.scrollWidth - rail.clientWidth;
      bar.style.transform = `scaleX(${max > 0 ? Math.max(0.08, rail.scrollLeft / max) : 1})`;
    };
    rail.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    document.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((b) =>
      b.addEventListener('click', () => {
        const card = rail.firstElementChild as HTMLElement;
        rail.scrollBy({ left: Number(b.dataset.dir) * (card.offsetWidth + 24), behavior: reduce.matches ? 'auto' : 'smooth' });
      }),
    );
  </script>

  <style is:global>
    :root { --bg: #0b0b0b; --ink: #f1ece2; --muted: #9d978c; --gold: #c8a96a; --line: #2a2722; --ease-out: cubic-bezier(0.23, 1, 0.32, 1); --ease-in-out: cubic-bezier(0.77, 0, 0.175, 1); }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; color-scheme: dark; }
    body { margin: 0; background: var(--bg); color: var(--ink); font: 15px/1.7 'Montserrat', system-ui, sans-serif; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: transparent; }
    img { display: block; max-width: 100%; height: auto; } /* height-Attribut von <Image> darf das Seitenverhältnis nicht überstimmen */
    a { color: inherit; }
    h1, h2, h3, p, ul, blockquote, figure { margin: 0; }
    :focus-visible { outline: 1px solid var(--gold); outline-offset: 4px; }

    .n-nav { position: fixed; inset: 0 0 auto; z-index: 10; display: flex; justify-content: space-between; align-items: center; padding: 14px clamp(16px, 4vw, 48px); background: linear-gradient(rgba(11, 11, 11, 0.8), transparent); }
    .n-logo { height: 40px; width: auto; filter: invert(1) hue-rotate(180deg); }
    .n-caps { font-size: 11px; letter-spacing: 0.4em; text-transform: uppercase; color: var(--gold); }

    .n-btn {
      display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 28px;
      background: var(--gold); color: #0b0b0b; text-decoration: none; font-size: 11px; font-weight: 500; letter-spacing: 0.28em; text-transform: uppercase;
      border: 1px solid var(--gold); transition: transform 160ms var(--ease-out), background-color 250ms ease, color 250ms ease;
    }
    .n-btn.ghost { background: transparent; color: var(--gold); }
    .n-btn.small { min-height: 44px; padding: 0 18px; }
    .n-btn:active { transform: scale(0.97); }
    @media (hover: hover) and (pointer: fine) {
      .n-btn:hover { background: transparent; color: var(--gold); }
      .n-btn.ghost:hover { background: var(--gold); color: #0b0b0b; }
    }

    /* Start: Bild setzt sich langsam, Zeilen steigen aus der Maske, Goldlinie zeichnet sich */
    .n-hero { position: relative; min-height: 100svh; display: flex; align-items: flex-end; overflow: hidden; }
    .n-hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(0.35) brightness(0.55); animation: n-settle 2400ms var(--ease-out) both; }
    @keyframes n-settle { from { transform: scale(1.12); opacity: 0; } }
    .n-hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, #0b0b0b 4%, transparent 60%); }
    .n-hero-text { position: relative; z-index: 1; padding: 0 clamp(20px, 6vw, 96px) clamp(48px, 10vh, 112px); max-width: 1100px; }
    h1 { font: italic 400 clamp(52px, 10vw, 140px)/0.95 'Playfair Display', Georgia, serif; letter-spacing: -0.02em; margin: 20px 0 0; }
    h1 em { font-style: normal; color: var(--gold); font-size: 0.5em; letter-spacing: 0; }
    .n-line { display: block; overflow: hidden; padding-bottom: 0.08em; }
    .n-line > span, .n-rise > span { display: inline-block; animation: n-up 1100ms var(--ease-out) both; animation-delay: calc(300ms + var(--d) * 140ms); }
    .n-rise { overflow: hidden; }
    @keyframes n-up { from { transform: translateY(110%); } }
    .n-rule { display: block; width: min(320px, 60vw); height: 1px; background: var(--gold); margin: 28px 0; transform-origin: left; animation: n-draw 1200ms var(--ease-in-out) 900ms both; }
    @keyframes n-draw { from { transform: scaleX(0.001); } }
    .n-actions > span { display: flex; flex-wrap: wrap; gap: 12px; }

    /* Abschnitte */
    .n-sec { padding: clamp(80px, 12vw, 160px) 0; border-top: 1px solid var(--line); }
    .n-head { padding: 0 clamp(20px, 6vw, 96px); margin-bottom: 48px; }
    h2, blockquote { font: italic 400 clamp(38px, 6vw, 80px)/1.05 'Playfair Display', Georgia, serif; margin-top: 16px; }
    .n-mask { overflow: hidden; }
    .n-mask > span { display: inline-block; transform: translateY(105%); transition: transform 1100ms var(--ease-out); }
    .n-mask.is-in > span { transform: none; }

    /* Karussell */
    .n-rail { display: flex; gap: 24px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 0 clamp(20px, 6vw, 96px); scroll-padding: 0 clamp(20px, 6vw, 96px); scrollbar-width: none; overscroll-behavior-x: contain; }
    .n-rail::-webkit-scrollbar { display: none; }
    .n-card { flex: 0 0 min(82vw, 420px); scroll-snap-align: start; background: #141414; border: 1px solid var(--line); }
    .n-card img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; filter: grayscale(0.3); }
    .n-card-body { padding: 28px; }
    .n-num { font: italic 40px/1 'Playfair Display', serif; color: var(--gold); }
    h3 { margin: 12px 0 16px; }
    h3 em { display: block; font: italic 400 30px/1.1 'Playfair Display', serif; }
    h3 span { font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--muted); font-weight: 400; }
    .n-card ul { list-style: none; padding: 0; color: var(--muted); }
    .n-card li { padding: 7px 0; border-top: 1px solid var(--line); }
    .n-rail-foot { display: flex; align-items: center; gap: 24px; padding: 28px clamp(20px, 6vw, 96px) 0; }
    .n-progress { flex: 1; height: 1px; background: var(--line); }
    .n-progress span { display: block; height: 100%; background: var(--gold); transform-origin: left; transform: scaleX(0.08); }
    .n-arrows { display: flex; gap: 8px; }
    .n-arrow { width: 48px; height: 48px; border: 1px solid var(--gold); background: none; color: var(--gold); font-size: 18px; cursor: pointer; transition: transform 160ms var(--ease-out); }
    .n-arrow:active { transform: scale(0.95); }
    .n-note { padding: 32px clamp(20px, 6vw, 96px) 0; color: var(--muted); font-style: italic; }

    /* Galerie: Bilder decken sich von links auf */
    .n-gallery { display: grid; gap: 16px; padding: 0 clamp(20px, 6vw, 96px); }
    @media (min-width: 900px) { .n-gallery { grid-template-columns: 1.6fr 1fr; grid-template-rows: 1fr 1fr; } .n-wipe.a { grid-row: span 2; } }
    .n-wipe img { width: 100%; height: 100%; min-height: 240px; object-fit: cover; }
    .n-wipe figcaption { font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--muted); margin-top: 10px; }
    .n-wipe { clip-path: inset(0 100% 0 0); transition: clip-path 1200ms var(--ease-in-out); transition-delay: calc(var(--d, 0) * 150ms); }
    .n-wipe.is-in { clip-path: inset(0 0 0 0); }

    .n-quote { position: relative; padding: clamp(120px, 20vw, 240px) clamp(20px, 6vw, 96px); text-align: center; overflow: hidden; }
    .n-quote-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) brightness(0.3); }
    .n-quote > :not(img) { position: relative; }
    .n-quote .n-caps { margin-top: 24px; }

    .n-contact { min-height: 90svh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 20px; text-align: center; padding: 80px 20px; border-top: 1px solid var(--line); }
    .n-phone { position: relative; font: italic 400 clamp(48px, 11vw, 150px)/1 'Playfair Display', serif; color: var(--gold); text-decoration: none; }
    .n-phone::after { content: ''; position: absolute; left: 0; right: 0; bottom: -6px; height: 1px; background: var(--gold); transform: scaleX(0.001); transform-origin: left; transition: transform 400ms var(--ease-out); }
    @media (hover: hover) and (pointer: fine) { .n-phone:hover::after { transform: scaleX(1); } }
    .n-addr { color: var(--muted); letter-spacing: 0.1em; }
    .n-legal { display: flex; gap: 24px; margin-top: 40px; font-size: 12px; }
    .n-legal a { display: inline-block; padding: 12px 0; color: var(--muted); text-decoration: none; }

    .no-js .n-mask > span { transform: none; }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      .n-hero-img, .n-line > span, .n-rise > span { animation: n-fade 600ms ease both; }
      .n-rule { animation: n-fade 600ms ease both; }
      .n-mask > span { transform: none; opacity: 0; transition: opacity 500ms ease; }
      .n-mask.is-in > span { opacity: 1; }
      .n-wipe { clip-path: none; opacity: 0; transition: opacity 500ms ease; }
      .n-wipe.is-in { opacity: 1; }
      .n-btn:active, .n-arrow:active { transform: none; }
    }
    @keyframes n-fade { from { opacity: 0; } }
  </style>
</Draft>
