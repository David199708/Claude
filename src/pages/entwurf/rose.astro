---
// Entwurf 3 · Rosé — Bento-Kacheln wie eine App, Behandlungen als Wendekarten, "Über mich" als
// Nachrichten-Blasen, schwebende Farbwolken im Hintergrund. Rosa, Beere, Flieder.
import { Image } from 'astro:assets';
import Draft from '../../layouts/Draft.astro';
import { studio, categories, extraNote } from '../../data/site';
import haus from '../../assets/gutshaus.webp';
import raum from '../../assets/innen-1.png';
import ecke from '../../assets/innen-2.png';
import gesicht from '../../assets/stock/gesicht.jpg';
import haende from '../../assets/stock/haende.jpg';
import pflege from '../../assets/stock/pflege.jpg';
import massage from '../../assets/stock/massage.jpg';
import '@fontsource/poppins/latin-400.css';
import '@fontsource/poppins/latin-600.css';
import '@fontsource/poppins/latin-700.css';

const photos = [gesicht, haende, pflege, massage];
const total = categories.reduce((n, c) => n + c.items.length, 0);
---

<Draft title="Rosé" theme="#fff6f8">
  <div class="r-blobs" aria-hidden="true"><span></span><span></span><span></span></div>

  <header class="r-nav">
    <a href="#start"><img src="/logo.png" alt={studio.name} class="r-logo" /></a>
    <nav><a href="#behandlungen">Angebot</a><a href="#raeume">Räume</a><a href="#hallo">Über mich</a></nav>
    <a class="r-btn small" href={studio.phoneHref}>Anrufen</a>
  </header>

  <main id="start" class="r-wrap">
    <!-- Bento-Raster -->
    <section class="r-bento">
      <div class="r-tile r-main" style="--i:0">
        <p class="r-tag">Kosmetik im Gutshaus</p>
        <h1>Wohlfühlstunden <span>für Körper und Sinne</span></h1>
        <a class="r-btn" href={studio.phoneHref}>Termin vereinbaren</a>
      </div>
      <div class="r-tile r-photo" style="--i:1"><Image src={haus} alt="Das Gutshaus in der Hofstraße" widths={[640]} sizes="(min-width: 900px) 50vw, 100vw" loading="eager" /></div>
      <div class="r-tile r-stat" style="--i:2"><strong>4</strong><span>Bereiche</span></div>
      <div class="r-tile r-stat lilac" style="--i:3"><strong>{total}</strong><span>Behandlungen</span></div>
      <div class="r-tile r-info" style="--i:4"><span class="r-dot"></span><span class="r-hours">{studio.hours}</span><a href={studio.phoneHref}>{studio.phone}</a></div>
      <div class="r-tile r-brand" style="--i:5">Pflege mit <strong>{studio.brand}</strong></div>
    </section>

    <!-- Wendekarten -->
    <section class="r-sec" id="behandlungen">
      <h2 data-in>Was darf’s sein? <span>Tippen zum Umdrehen ✨</span></h2>
      <div class="r-flips">
        {categories.map((c, i) => (
          <button class="r-flip" aria-pressed="false" data-in style={`--d:${i}`} aria-label={`${c.title}: Behandlungen anzeigen`}>
            <span class="r-face r-front">
              <Image src={photos[i]} alt="" widths={[480]} sizes="(min-width: 900px) 25vw, 50vw" loading="lazy" />
              <span class="r-front-text"><em>{c.accent}</em>{c.title}</span>
            </span>
            <span class="r-face r-back">
              <em>{c.accent}</em>
              <span class="r-list">{c.items.map((t) => <span>{t.name}</span>)}</span>
            </span>
          </button>
        ))}
      </div>
      <p class="r-note" data-in>{extraNote}</p>
    </section>

    <!-- Räume als Fotokarten -->
    <section class="r-sec" id="raeume">
      <h2 data-in>Schau dich um <span>im Gutshaus</span></h2>
      <div class="r-polas">
        <figure class="r-pola" data-in style="--r:-4deg;--d:0"><Image src={haus} alt="Das Gutshaus" widths={[480]} sizes="33vw" loading="lazy" /><figcaption>Das Haus</figcaption></figure>
        <figure class="r-pola" data-in style="--r:3deg;--d:1"><Image src={raum} alt="Der Behandlungsraum" widths={[480]} sizes="33vw" loading="lazy" /><figcaption>Behandlungsraum</figcaption></figure>
        <figure class="r-pola" data-in style="--r:-2deg;--d:2"><Image src={ecke} alt="Die Sitzecke" widths={[480]} sizes="33vw" loading="lazy" /><figcaption>Sitzecke</figcaption></figure>
      </div>
    </section>

    <!-- Über mich als Chat -->
    <section class="r-sec r-chat" id="hallo" data-in>
      <h2>Hallo! 👋</h2>
      <p class="r-bubble" style="--d:0">Ich bin {studio.owner} und führe das Studio „{studio.name}“.</p>
      <p class="r-bubble" style="--d:1">Bei mir gibt es keine Fließbandtermine – jede Behandlung beginnt mit einem Gespräch.</p>
      <p class="r-bubble me" style="--d:2">Klingt gut! Wie bekomme ich einen Termin?</p>
      <p class="r-bubble" style="--d:3">Ruf einfach an: <a href={studio.phoneHref}>{studio.phone}</a> 😊</p>
    </section>

    <section class="r-cta" id="kontakt" data-in>
      <h2>Bis bald im Gutshaus</h2>
      <p>{studio.street} · {studio.zip} {studio.city}</p>
      <div class="r-cta-actions">
        <a class="r-btn white" href={studio.phoneHref}>{studio.phone}</a>
        <a class="r-btn outline" href={studio.mapsUrl} target="_blank" rel="noopener">Route planen</a>
      </div>
    </section>

    <footer class="r-foot"><a href="/impressum">Impressum</a><a href="/datenschutz">Datenschutz</a></footer>
  </main>

  <script>
    // Wendekarten: Antippen dreht die Karte
    document.querySelectorAll<HTMLButtonElement>('.r-flip').forEach((b) =>
      b.addEventListener('click', () => b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true'))),
    );
  </script>

  <style is:global>
    :root { --bg: #fff6f8; --ink: #3a2230; --muted: #7c6271; --berry: #b0306a; --lilac: #8d6cc9; --spring: cubic-bezier(0.34, 1.56, 0.64, 1); --ease-out: cubic-bezier(0.23, 1, 0.32, 1); }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; scroll-padding-top: 96px; -webkit-text-size-adjust: 100%; }
    body { margin: 0; background: var(--bg); color: var(--ink); font: 16px/1.6 'Poppins', system-ui, sans-serif; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: transparent; overflow-x: hidden; }
    img { display: block; max-width: 100%; height: auto; } /* height-Attribut von <Image> darf das Seitenverhältnis nicht überstimmen */
    a { color: inherit; }
    h1, h2, p, figure { margin: 0; }
    :focus-visible { outline: 3px solid var(--lilac); outline-offset: 3px; }

    /* Schwebende Farbwolken: ruhig, nur Dekoration */
    .r-blobs { position: fixed; inset: 0; z-index: -1; overflow: hidden; }
    .r-blobs span { position: absolute; width: 50vmax; height: 50vmax; border-radius: 50%; filter: blur(60px); opacity: 0.55; animation: r-drift 22s ease-in-out infinite alternate; }
    .r-blobs span:nth-child(1) { background: #ffc6d9; top: -15vmax; left: -10vmax; }
    .r-blobs span:nth-child(2) { background: #e3d4ff; top: 30vh; right: -20vmax; animation-delay: -7s; }
    .r-blobs span:nth-child(3) { background: #ffe1cc; bottom: -25vmax; left: 20vw; animation-delay: -14s; }
    @keyframes r-drift { to { transform: translate(6vmax, 4vmax) scale(1.1); } }

    .r-nav {
      position: sticky; top: 12px; z-index: 10; margin: 12px auto 0; width: min(1080px, calc(100% - 24px));
      display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 8px 8px 8px 20px;
      background: rgba(255, 255, 255, 0.75); backdrop-filter: blur(16px) saturate(1.6); -webkit-backdrop-filter: blur(16px) saturate(1.6);
      border-radius: 999px; box-shadow: 0 10px 30px -12px rgba(176, 48, 106, 0.25);
    }
    .r-logo { height: 36px; width: auto; }
    .r-nav nav { display: none; gap: 24px; font-size: 14px; font-weight: 600; }
    .r-nav nav a { text-decoration: none; padding: 12px 0; }
    @media (min-width: 820px) { .r-nav nav { display: flex; } }

    .r-btn {
      display: inline-flex; align-items: center; justify-content: center; min-height: 52px; padding: 0 28px; border-radius: 999px;
      background: linear-gradient(135deg, #c2407a, var(--lilac)); color: #fff; font-weight: 600; text-decoration: none;
      transition: transform 200ms var(--spring), box-shadow 200ms ease;
      box-shadow: 0 10px 24px -10px rgba(176, 48, 106, 0.6);
    }
    .r-btn.small { min-height: 44px; padding: 0 20px; font-size: 14px; }
    .r-btn.white { background: #fff; color: var(--berry); }
    .r-btn.outline { background: transparent; border: 2px solid rgba(255, 255, 255, 0.7); box-shadow: none; }
    .r-btn:active { transform: scale(0.95); }
    @media (hover: hover) and (pointer: fine) { .r-btn:hover { transform: translateY(-2px); } }

    .r-wrap { width: min(1080px, calc(100% - 24px)); margin: 0 auto; }

    /* Bento */
    .r-bento { display: grid; gap: 14px; margin-top: 28px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .r-tile {
      border-radius: 28px; background: rgba(255, 255, 255, 0.8); padding: 22px; box-shadow: 0 20px 40px -28px rgba(141, 108, 201, 0.5);
      animation: r-pop 700ms var(--spring) both; animation-delay: calc(100ms + var(--i) * 70ms);
    }
    @keyframes r-pop { from { opacity: 0; transform: scale(0.92) translateY(14px); } }
    .r-main { grid-column: 1 / -1; background: linear-gradient(135deg, #ffe0eb, #efe4ff); padding: 32px 26px; }
    .r-photo { grid-column: 1 / -1; padding: 0; overflow: hidden; min-height: 220px; }
    .r-photo img { width: 100%; height: 100%; object-fit: cover; }
    .r-tag { font-size: 13px; font-weight: 600; color: var(--lilac); }
    h1 { font-size: clamp(34px, 4.6vw, 56px); overflow-wrap: break-word; hyphens: auto; line-height: 1.02; letter-spacing: -0.04em; font-weight: 700; margin: 10px 0 24px; }
    h1 span { display: block; background: linear-gradient(90deg, var(--berry), var(--lilac)); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .r-stat strong { display: block; font-size: 44px; line-height: 1; font-weight: 700; color: var(--berry); }
    .r-stat.lilac strong { color: var(--lilac); }
    .r-stat span { font-size: 14px; color: var(--muted); }
    .r-info, .r-brand { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; font-weight: 600; }
    .r-info a { margin-left: auto; color: var(--berry); text-decoration: none; padding: 10px 0; white-space: nowrap; }
    .r-hours { min-width: 0; }
    .r-dot { flex: none; width: 10px; height: 10px; border-radius: 50%; background: #3ab07e; box-shadow: 0 0 0 4px rgba(58, 176, 126, 0.2); }
    .r-brand { justify-content: center; background: var(--ink); color: #fff; }
    @media (min-width: 900px) {
      .r-bento { grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: 150px; }
      .r-main { grid-column: span 2; grid-row: span 2; display: flex; flex-direction: column; justify-content: center; }
      .r-photo { grid-column: span 2; grid-row: span 2; }
      .r-info { grid-column: span 1; flex-direction: column; flex-wrap: nowrap; gap: 4px; align-items: flex-start; justify-content: center; }
      .r-info a { margin-left: 0; }
      .r-brand { grid-column: span 1; }
    }

    .r-sec { padding: clamp(64px, 10vw, 112px) 0 0; }
    h2 { font-size: clamp(30px, 5vw, 48px); font-weight: 700; letter-spacing: -0.035em; line-height: 1.1; margin-bottom: 28px; }
    h2 span { display: block; font-size: 0.45em; font-weight: 600; color: var(--lilac); letter-spacing: 0; margin-top: 6px; }

    /* Wendekarten */
    .r-flips { display: grid; gap: 14px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    @media (min-width: 900px) { .r-flips { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
    .r-flip { position: relative; aspect-ratio: 3 / 4; border: 0; padding: 0; background: none; cursor: pointer; perspective: 1000px; font: inherit; color: inherit; text-align: left; }
    .r-face { position: absolute; inset: 0; border-radius: 24px; overflow: hidden; backface-visibility: hidden; -webkit-backface-visibility: hidden; transition: transform 600ms var(--spring); box-shadow: 0 20px 40px -24px rgba(176, 48, 106, 0.5); }
    .r-front img { width: 100%; height: 100%; object-fit: cover; }
    .r-front-text { position: absolute; inset: auto 0 0; padding: 40px 16px 16px; background: linear-gradient(transparent, rgba(58, 34, 48, 0.75)); color: #fff; font-weight: 600; font-size: 15px; }
    .r-front-text em, .r-back em { display: block; font-style: normal; font-size: 22px; font-weight: 700; }
    .r-back { transform: rotateY(180deg); background: linear-gradient(160deg, #fff, #f7ecff); padding: 18px; display: flex; flex-direction: column; gap: 10px; }
    .r-back em { color: var(--berry); }
    .r-list { display: flex; flex-wrap: wrap; gap: 6px; }
    .r-list span { background: #fff; border-radius: 999px; padding: 4px 10px; font-size: 12px; box-shadow: 0 2px 6px rgba(141, 108, 201, 0.15); }
    .r-flip[aria-pressed='true'] .r-front { transform: rotateY(-180deg); }
    .r-flip[aria-pressed='true'] .r-back { transform: rotateY(0deg); }
    .no-js .r-flip { aspect-ratio: auto; }
    .no-js .r-face { position: relative; transform: none; }
    .r-note { margin-top: 20px; color: var(--muted); }

    /* Fotokarten */
    .r-polas { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
    .r-pola { background: #fff; padding: 8px 8px 0; border-radius: 10px; box-shadow: 0 16px 30px -18px rgba(58, 34, 48, 0.4); transform: rotate(var(--r)); }
    .r-pola img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 6px; }
    .r-pola figcaption { font-size: clamp(11px, 2.4vw, 14px); font-weight: 600; text-align: center; padding: 8px 0 10px; }
    @media (hover: hover) and (pointer: fine) { .r-pola { transition: transform 300ms var(--spring); } .r-pola:hover { transform: rotate(0) scale(1.04); } }

    /* Chat-Blasen erscheinen nacheinander */
    .r-chat { max-width: 640px; }
    .r-bubble { max-width: 85%; width: fit-content; background: #fff; padding: 12px 18px; border-radius: 22px 22px 22px 6px; margin-bottom: 10px; box-shadow: 0 8px 20px -14px rgba(141, 108, 201, 0.6); opacity: 0; transform: translateY(10px) scale(0.96); transform-origin: bottom left; transition: opacity 400ms var(--ease-out), transform 500ms var(--spring); transition-delay: calc(200ms + var(--d) * 450ms); }
    .r-bubble.me { margin-left: auto; background: linear-gradient(135deg, #c2407a, var(--lilac)); color: #fff; border-radius: 22px 22px 6px 22px; transform-origin: bottom right; }
    .r-bubble a { color: var(--berry); font-weight: 600; }
    .r-chat.is-in .r-bubble, .no-js .r-bubble { opacity: 1; transform: none; }

    .r-cta { margin-top: clamp(64px, 10vw, 112px); border-radius: 36px; padding: clamp(36px, 6vw, 64px) 24px; text-align: center; color: #fff; background: linear-gradient(135deg, #b0306a, #7b5cc0); }
    .r-cta h2 { margin-bottom: 8px; }
    .r-cta-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 24px; }
    .r-foot { display: flex; justify-content: center; gap: 24px; padding: 32px 0 40px; font-size: 13px; }
    .r-foot a { padding: 12px 0; color: var(--muted); }

    /* Einblenden mit kleinem Federn */
    [data-in] { opacity: 0; transform: translateY(18px) scale(0.98); transition: opacity 500ms var(--ease-out), transform 700ms var(--spring); transition-delay: calc(var(--d, 0) * 80ms); }
    [data-in].is-in { opacity: 1; transform: none; }
    .r-pola[data-in].is-in { transform: rotate(var(--r)); }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      .r-blobs span { animation: none; }
      .r-tile { animation: r-fade 400ms ease both; }
      [data-in], .r-bubble { transform: none; transition: opacity 400ms ease; }
      .r-pola[data-in].is-in { transform: rotate(var(--r)); }
      .r-face { transition: none; }
      .r-btn:active { transform: none; }
    }
    @keyframes r-fade { from { opacity: 0; } }
  </style>
</Draft>
