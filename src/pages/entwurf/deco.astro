---
// Entwurf 5 · Art Déco — streng symmetrisch, alles mittig. Sonnen-Ornament zeichnet sich,
// Bogenfenster öffnen sich nach oben, Behandlungen hinter vier Bogentüren, die aufschwingen.
// Nachtblau, Champagner, Gold – passend zur Schrift im Logo.
import { Image } from 'astro:assets';
import Draft from '../../layouts/Draft.astro';
import { studio, categories, extraNote } from '../../data/site';
import haus from '../../assets/gutshaus.webp';
import raum from '../../assets/innen-1.png';
import ecke from '../../assets/innen-2.png';
import gesicht from '../../assets/stock/gesicht.jpg';
import haende from '../../assets/stock/haende.jpg';
import pflege from '../../assets/stock/pflege.jpg';
import massage from '../../assets/stock/massage.jpg';
import '@fontsource/poiret-one/latin-400.css';
import '@fontsource/josefin-sans/latin-300.css';
import '@fontsource/josefin-sans/latin-400.css';
import '@fontsource/josefin-sans/latin-600.css';

const photos = [gesicht, haende, pflege, massage];
const rays = Array.from({ length: 24 }, (_, i) => i * 15);
---

<Draft title="Art Déco" theme="#0f2633">
  <header class="d-nav">
    <a class="d-side" href="#tueren">Behandlungen</a>
    <a href="#start" class="d-logo-link"><img src="/logo.png" alt={studio.name} class="d-logo" /></a>
    <a class="d-side" href={studio.phoneHref}>Anrufen</a>
  </header>

  <main id="start">
    <section class="d-hero">
      <svg class="d-sun" viewBox="-200 -200 400 400" aria-hidden="true">
        {rays.map((a, i) => <line x1="0" y1="-60" x2="0" y2="-190" transform={`rotate(${a})`} pathLength="1" style={`--i:${i}`} />)}
        <circle r="56" pathLength="1" style="--i:0" />
        <circle r="44" pathLength="1" style="--i:4" />
      </svg>
      <p class="d-caps">Kosmetik im Gutshaus</p>
      <h1>Wohlfühl&shy;stunden</h1>
      <p class="d-sub">für Körper und Sinne</p>
      <div class="d-divider" aria-hidden="true"><span></span>◆<span></span></div>
      <a class="d-btn" href={studio.phoneHref}>Termin vereinbaren</a>
      <figure class="d-arch d-arch-hero" data-in><Image src={haus} alt="Das Gutshaus in der Hofstraße" widths={[640]} sizes="(min-width: 900px) 480px, 80vw" loading="eager" /></figure>
    </section>

    <section class="d-sec" id="tueren">
      <p class="d-caps">Das Programm</p>
      <h2>Vier Türen</h2>
      <p class="d-intro">Tippen Sie auf eine Tür, um einzutreten.</p>
      <div class="d-doors">
        {categories.map((c, i) => (
          <div class="d-door-wrap" data-in style={`--d:${i}`}>
            <div class="d-room">
              <p class="d-room-title">{c.accent}</p>
              <ul>{c.items.map((t) => <li>{t.name}</li>)}</ul>
            </div>
            <button class="d-door" aria-expanded="false" aria-label={`${c.title} öffnen`}>
              <Image src={photos[i]} alt="" widths={[400]} sizes="(min-width: 900px) 22vw, 45vw" loading="lazy" />
              <span class="d-door-label"><span>{c.accent}</span><small>{c.title}</small></span>
            </button>
          </div>
        ))}
      </div>
      <p class="d-intro">{extraNote}</p>
    </section>

    <section class="d-sec">
      <p class="d-caps">Das Gutshaus</p>
      <h2>Drei Fenster</h2>
      <div class="d-windows">
        <figure class="d-arch" data-in style="--d:1"><Image src={raum} alt="Der Behandlungsraum" widths={[480]} sizes="30vw" loading="lazy" /><figcaption>Behandlungsraum</figcaption></figure>
        <figure class="d-arch big" data-in style="--d:0"><Image src={haus} alt="Das Gutshaus" widths={[640]} sizes="36vw" loading="lazy" /><figcaption>Das Haus</figcaption></figure>
        <figure class="d-arch" data-in style="--d:2"><Image src={ecke} alt="Die Sitzecke" widths={[480]} sizes="30vw" loading="lazy" /><figcaption>Sitzecke</figcaption></figure>
      </div>
    </section>

    <section class="d-sec d-quote">
      <div class="d-divider grow" data-in aria-hidden="true"><span></span>◆<span></span></div>
      <blockquote>„Keine Fließbandtermine – jede Behandlung beginnt mit einem Gespräch.“</blockquote>
      <p class="d-caps">{studio.owner}</p>
      <div class="d-divider grow" data-in aria-hidden="true"><span></span>◆<span></span></div>
    </section>

    <section class="d-sec d-contact" id="kontakt">
      <div class="d-frame">
        <p class="d-caps">{studio.hours}</p>
        <a class="d-phone" href={studio.phoneHref}>{studio.phone}</a>
        <p>{studio.street} · {studio.zip} {studio.city}</p>
        <a class="d-btn ghost" href={studio.mapsUrl} target="_blank" rel="noopener">Route planen</a>
      </div>
      <p class="d-legal"><a href="/impressum">Impressum</a> ◆ <a href="/datenschutz">Datenschutz</a></p>
    </section>
  </main>

  <script>
    // Bogentüren: Antippen öffnet die Tür und gibt den Blick auf die Behandlungen frei
    document.querySelectorAll<HTMLButtonElement>('.d-door').forEach((b) => {
      const toggle = () => b.setAttribute('aria-expanded', String(b.getAttribute('aria-expanded') !== 'true'));
      b.addEventListener('click', toggle);
      // Tippen auf den Raum dahinter schließt die Tür wieder
      b.previousElementSibling?.addEventListener('click', () => b.getAttribute('aria-expanded') === 'true' && toggle());
    });
  </script>

  <style is:global>
    :root { --bg: #0f2633; --deep: #0b1e29; --ink: #f1e7d0; --muted: #b8b09d; --gold: #d4b26a; --coral: #e07a5f; --ease-out: cubic-bezier(0.23, 1, 0.32, 1); --ease-in-out: cubic-bezier(0.77, 0, 0.175, 1); }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; color-scheme: dark; }
    body { margin: 0; background: var(--bg); color: var(--ink); font: 300 17px/1.7 'Josefin Sans', system-ui, sans-serif; text-align: center; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: transparent; }
    img { display: block; max-width: 100%; height: auto; } /* height-Attribut von <Image> darf das Seitenverhältnis nicht überstimmen */
    a { color: inherit; }
    h1, h2, p, ul, blockquote, figure { margin: 0; }
    :focus-visible { outline: 1px solid var(--gold); outline-offset: 4px; }

    .d-nav { position: sticky; top: 0; z-index: 10; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; height: 64px; padding: 0 clamp(12px, 3vw, 40px); background: rgba(15, 38, 51, 0.9); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom: 3px double var(--gold); }
    .d-side { font-size: 12px; font-weight: 600; letter-spacing: 0.24em; text-transform: uppercase; text-decoration: none; color: var(--gold); padding: 14px 0; }
    .d-side:first-child { justify-self: start; }
    .d-side:last-child { justify-self: end; }
    .d-logo { height: 40px; width: auto; filter: invert(1) hue-rotate(180deg); }
    .d-caps { font-size: 12px; font-weight: 600; letter-spacing: 0.4em; text-transform: uppercase; color: var(--coral); }

    .d-btn { display: inline-flex; align-items: center; min-height: 50px; padding: 4px 32px 0; background: var(--gold); color: var(--bg); font-weight: 600; font-size: 13px; letter-spacing: 0.24em; text-transform: uppercase; text-decoration: none; border: 1px solid var(--gold); outline: 1px solid var(--gold); outline-offset: 4px; transition: transform 160ms var(--ease-out), background-color 250ms ease, color 250ms ease; }
    .d-btn.ghost { background: transparent; color: var(--gold); }
    .d-btn:active { transform: scale(0.97); }
    @media (hover: hover) and (pointer: fine) { .d-btn:hover { background: transparent; color: var(--gold); } .d-btn.ghost:hover { background: var(--gold); color: var(--bg); } }

    /* Start: Sonnen-Ornament zeichnet sich Strahl für Strahl */
    .d-hero { position: relative; padding: clamp(56px, 10vw, 120px) 20px clamp(64px, 10vw, 120px); overflow: hidden; border-bottom: 3px double var(--gold); }
    .d-sun { position: absolute; left: 50%; top: clamp(-40px, -2vw, 0px); width: min(720px, 150vw); transform: translateX(-50%); stroke: var(--gold); stroke-width: 1; fill: none; opacity: 0.35; animation: d-turn 3000ms var(--ease-out) both; }
    .d-sun line, .d-sun circle { stroke-dasharray: 1; stroke-dashoffset: 1; animation: d-draw 900ms var(--ease-out) forwards; animation-delay: calc(200ms + var(--i) * 40ms); }
    @keyframes d-draw { to { stroke-dashoffset: 0; } }
    @keyframes d-turn { from { transform: translateX(-50%) rotate(-12deg); } }
    .d-hero > :not(svg) { position: relative; }
    h1 { font: 400 clamp(40px, 9vw, 112px)/1 'Poiret One', Georgia, serif; letter-spacing: 0.06em; text-transform: uppercase; margin: 24px 0 8px; color: var(--ink); }
    .d-sub { font: 400 clamp(20px, 3vw, 30px) 'Poiret One', serif; letter-spacing: 0.2em; color: var(--gold); }
    .d-divider { display: flex; align-items: center; justify-content: center; gap: 14px; color: var(--gold); margin: 28px auto; max-width: 360px; font-size: 12px; }
    .d-divider span { flex: 1; height: 1px; background: var(--gold); }
    .d-divider.grow span:first-child { transform-origin: right; }
    .d-divider.grow span:last-child { transform-origin: left; }
    .d-divider.grow span { transform: scaleX(0.001); transition: transform 1000ms var(--ease-in-out); }
    .d-divider.grow.is-in span { transform: none; }

    /* Bogenfenster öffnen sich von unten nach oben */
    .d-arch { position: relative; margin: 0 auto; border-radius: 999px 999px 0 0; overflow: hidden; outline: 1px solid var(--gold); outline-offset: 8px; clip-path: inset(100% 0 0 0 round 999px 999px 0 0); transition: clip-path 1300ms var(--ease-in-out); transition-delay: calc(var(--d, 0) * 160ms); }
    .d-arch.is-in { clip-path: inset(0 0 0 0 round 999px 999px 0 0); }
    .d-arch img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; }
    .d-arch-hero { width: min(420px, 80vw); margin-top: 56px; }
    .d-arch figcaption { position: absolute; inset: auto 0 0; padding: 40px 8px 12px; background: linear-gradient(transparent, rgba(11, 30, 41, 0.9)); font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--gold); }

    .d-sec { padding: clamp(72px, 11vw, 140px) 20px; border-bottom: 3px double var(--gold); }
    h2 { font: 400 clamp(36px, 6vw, 72px)/1.1 'Poiret One', serif; letter-spacing: 0.08em; text-transform: uppercase; margin: 16px 0; }
    .d-intro { color: var(--muted); margin: 12px auto 40px; max-width: 34em; }
    .d-intro:last-child { margin: 40px auto 0; }

    /* Bogentüren: schwingen nach links auf */
    .d-doors { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; max-width: 1080px; margin: 0 auto; }
    @media (min-width: 900px) { .d-doors { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px; } }
    .d-door-wrap { position: relative; aspect-ratio: 3 / 5; perspective: 1200px; border-radius: 999px 999px 0 0; outline: 1px solid var(--gold); outline-offset: 6px; }
    .d-room { position: absolute; inset: 0; border-radius: 999px 999px 0 0; background: var(--deep); padding: 30% 12px 16px; overflow: auto; }
    .d-room-title { font: 400 22px 'Poiret One', serif; color: var(--gold); letter-spacing: 0.08em; margin-bottom: 8px; }
    .d-room ul { list-style: none; padding: 0; font-size: 14px; line-height: 1.4; }
    .d-room li { padding: 5px 0; border-top: 1px solid rgba(212, 178, 106, 0.2); }
    .d-door { position: absolute; inset: 0; border: 0; padding: 0; background: #0b1e29; cursor: pointer; border-radius: 999px 999px 0 0; overflow: hidden; transform-origin: left center; transition: transform 700ms var(--ease-in-out); color: inherit; font: inherit; }
    .d-door img { width: 100%; height: 100%; object-fit: cover; filter: sepia(0.35) brightness(0.7); }
    .d-door-label { position: absolute; inset: auto 0 0; padding: 48px 8px 18px; background: linear-gradient(transparent, rgba(11, 30, 41, 0.95)); display: flex; flex-direction: column; gap: 2px; }
    .d-door-label span { font: 400 clamp(20px, 2.4vw, 26px) 'Poiret One', serif; color: var(--gold); letter-spacing: 0.06em; }
    .d-door-label small { font-size: 10px; letter-spacing: 0.24em; text-transform: uppercase; }
    .d-door[aria-expanded='true'] { transform: rotateY(-105deg); }
    .no-js .d-door-wrap { aspect-ratio: auto; }
    .no-js .d-room { position: relative; padding-top: 24px; }
    .no-js .d-door { display: none; }

    .d-windows { display: grid; grid-template-columns: 1fr 1.25fr 1fr; gap: clamp(12px, 3vw, 40px); align-items: end; max-width: 980px; margin: 40px auto 0; }

    blockquote { font: 400 clamp(26px, 4vw, 48px)/1.3 'Poiret One', serif; letter-spacing: 0.04em; max-width: 820px; margin: 0 auto 20px; }

    .d-frame { max-width: 720px; margin: 0 auto; padding: clamp(40px, 7vw, 72px) 20px; border: 1px solid var(--gold); outline: 1px solid var(--gold); outline-offset: -12px; display: flex; flex-direction: column; align-items: center; gap: 16px; }
    .d-phone { font: 400 clamp(40px, 8vw, 88px)/1.1 'Poiret One', serif; color: var(--gold); text-decoration: none; letter-spacing: 0.04em; }
    .d-legal { margin-top: 32px; color: var(--gold); font-size: 13px; }
    .d-legal a { display: inline-block; padding: 12px 6px; color: var(--muted); text-decoration: none; }

    [data-in]:not(.d-arch):not(.d-divider) { opacity: 0; transform: translateY(24px); transition: opacity 900ms var(--ease-out), transform 900ms var(--ease-out); transition-delay: calc(var(--d, 0) * 120ms); }
    [data-in].is-in:not(.d-arch):not(.d-divider) { opacity: 1; transform: none; }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      .d-sun, .d-sun line, .d-sun circle { animation: none; stroke-dashoffset: 0; }
      .d-sun { transform: translateX(-50%); }
      .d-arch { clip-path: none; opacity: 0; transition: opacity 500ms ease; }
      .d-arch.is-in { opacity: 1; }
      .d-divider.grow span { transform: none; transition: none; }
      [data-in]:not(.d-arch):not(.d-divider) { transform: none; transition: opacity 400ms ease; }
      .d-door { transition: opacity 300ms ease; }
      .d-door[aria-expanded='true'] { transform: none; opacity: 0; pointer-events: auto; }
      .d-btn:active { transform: none; }
    }
  </style>
</Draft>
