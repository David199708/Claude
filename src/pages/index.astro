---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ManorIllustration from '../components/ManorIllustration.astro';
import Treatments from '../components/Treatments.astro';
import HouseTour from '../components/HouseTour.astro';
import MoodBand from '../components/MoodBand.astro';
import { Image } from 'astro:assets';
import stillleben from '../assets/stock/stillleben.jpg';
import { studio } from '../data/site';
---

<Base>
  <Header />

  <main>
    <!-- Start -->
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-text">
          <p class="eyebrow enter">Kosmetikstudio in {studio.city}</p>
          <h1 class="enter" style="--i: 1">
            Wohlfühlstunden<br /><em class="nowrap">für Körper und Sinne.</em>
          </h1>
          <p class="lead enter" style="--i: 2">
            Persönliche Kosmetik in ruhiger, besonderer Atmosphäre – mit viel Zeit,
            Erfahrung und einem Blick für das, was Ihrer Haut guttut.
          </p>
          <div class="actions enter" style="--i: 3">
            <a href={studio.phoneHref} class="btn btn-primary ring">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
              <span class="touch-label">Termin vereinbaren</span><span class="desk-num">Termin: {studio.phone}</span>
            </a>
            <a href="#behandlungen" class="btn btn-ghost">Behandlungen ansehen</a>
          </div>
        </div>
        <div class="hero-art reveal-draw">
          <ManorIllustration />
        </div>
      </div>
    </section>

    <!-- Behandlungen -->
    <section id="behandlungen" class="section">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Behandlungen</p>
          <h2 class="words">Was ich für Sie tun kann</h2>
          <p class="note">Es erwartet Sie ein Komplettprogramm rund um die Schönheit – mit hochwertiger Pflege von {studio.brand}. Gerne berate ich Sie persönlich, welche Behandlung zu Ihnen passt.</p>
        </div>

        <Treatments />
      </div>
    </section>

    <MoodBand />

    <!-- Das Gutshaus: Scroll-Fahrt von außen nach innen -->
    <HouseTour />

    <!-- Über mich -->
    <section id="ueber-mich" class="section about">
      <div class="container about-grid">
        <div class="portrait reveal-clip">
          <!-- Stimmungsbild als Platzhalter, bis ein Foto von der Inhaberin da ist -->
          <Image src={stillleben} alt="Handtuch, Kerze und Tulpen – Ruhe im Studio" widths={[480, 880]} sizes="(min-width: 900px) 440px, 90vw" loading="lazy" />
        </div>
        <div class="about-text reveal" style="--delay: 80ms">
          <p class="eyebrow">Über mich</p>
          <h2 class="words">Schön, dass Sie da sind.</h2>
          <p>
            Ich bin {studio.owner} und führe das Studio „{studio.name}“ mit viel Herz.
            <mark>PLATZHALTER: Hier stehen ein paar persönliche Sätze – Ausbildung, wie lange
            schon, was ihr bei der Arbeit wichtig ist.</mark>
          </p>
          <p>
            Bei mir gibt es keine Fließbandtermine: Jede Behandlung beginnt mit einem
            Gespräch, und ich nehme mir die Zeit, die Ihre Haut braucht.
          </p>
        </div>
      </div>
    </section>

    <!-- Kontakt -->
    <section id="kontakt" class="section contact">
      <div class="container">
        <div class="contact-card reveal reveal-scale">
          <div>
            <p class="eyebrow">Termin & Kontakt</p>
            <h2 class="words">Ich freue mich auf Sie.</h2>
            <p class="lead">
              Vereinbaren Sie ganz einfach telefonisch einen Termin und
              überzeugen Sie sich selbst!
            </p>
            <a href={studio.phoneHref} class="btn btn-primary phone">{studio.phone}</a>
          </div>
          <dl>
            <div>
              <dt>Adresse</dt>
              <dd>
                {studio.name}<br />
                {studio.street}<br />
                {studio.zip} {studio.city}<br />
                <a href={studio.mapsUrl} target="_blank" rel="noopener" class="route">Route planen <span class="arrow" aria-hidden="true">↗</span></a>
              </dd>
            </div>
            <div>
              <dt>Telefon</dt>
              <dd><a href={studio.phoneHref}>{studio.phone}</a></dd>
            </div>
            {studio.email && (
              <div>
                <dt>E-Mail</dt>
                <dd><a href={`mailto:${studio.email}`}>{studio.email}</a></dd>
              </div>
            )}
            <div>
              <dt>Öffnungszeiten</dt>
              <dd>{studio.hours}</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* Start */
  .hero {
    padding: clamp(48px, 9vw, 112px) 0 clamp(56px, 8vw, 96px);
    background:
      radial-gradient(60% 80% at 85% 20%, rgba(143, 207, 176, 0.22), transparent 70%),
      var(--cream);
  }

  .hero-grid {
    display: grid;
    gap: 48px;
    align-items: center;
  }

  h1 {
    font-size: clamp(42px, 5.4vw, 66px);
    margin: 16px 0 24px;
  }

  @media (min-width: 900px) {
    .nowrap {
      white-space: nowrap;
    }
  }

  h1 em {
    color: var(--sage-dark);
  }

  .lead {
    font-size: 18px;
    color: var(--muted);
    max-width: 34em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .hero-art {
    color: var(--sage-dark);
    max-width: 520px;
    justify-self: center;
    width: 100%;
  }

  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1.1fr 1fr;
    }
  }

  /* Abschnitte */
  .section {
    padding: clamp(64px, 10vw, 120px) 0;
  }

  .section-head {
    max-width: 640px;
    margin-bottom: 48px;
  }

  h2 {
    font-size: clamp(36px, 5.5vw, 56px);
    margin: 12px 0 16px;
  }

  .note {
    color: var(--muted);
    font-size: 15px;
  }

  /* Über mich */
  .about {
    background: var(--cream);
  }

  .about-grid {
    display: grid;
    gap: 40px;
    align-items: center;
  }

  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: 0.8fr 1fr;
      gap: 72px;
    }
  }

  .portrait {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    background:
      linear-gradient(160deg, rgba(255, 255, 255, 0.4), transparent),
      var(--sand);
    overflow: hidden;
    max-width: 440px;
    width: 100%;
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 899px) {
    .portrait {
      aspect-ratio: 4 / 3;
    }
  }

  .about-text p:not(.eyebrow) {
    color: var(--muted);
    margin-top: 16px;
    max-width: 34em;
  }

  mark {
    background: #fff3c4;
    color: var(--ink);
    padding: 0 2px;
  }

  /* Kontakt */
  .contact-card {
    display: grid;
    gap: 40px;
    background: var(--sage-dark);
    color: #fff;
    border-radius: calc(var(--radius) + 6px);
    padding: clamp(32px, 6vw, 64px);
  }

  .contact-card .eyebrow,
  .contact-card .lead,
  .contact-card dt {
    color: rgba(255, 255, 255, 0.72);
  }

  .contact-card .btn-primary {
    background: #fff;
    color: var(--sage-dark);
    margin-top: 28px;
    font-size: 17px;
    font-variant-numeric: tabular-nums;
  }

  @media (hover: hover) and (pointer: fine) {
    .contact-card .btn-primary:hover {
      background: var(--cream);
    }
  }

  dl {
    margin: 0;
    display: grid;
    gap: 24px;
    align-content: start;
  }

  dt {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  dd {
    margin: 0;
  }

  /* 44px Tippfläche, ohne das Layout zu verschieben */
  dd a {
    display: inline-block;
    padding-block: 12px;
    margin-block: -12px;
    text-underline-offset: 3px;
  }

  /* Am Computer führt ein tel:-Link oft ins Leere: Nummer direkt im Button zeigen */
  .desk-num {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .desk-num {
      display: inline;
      font-variant-numeric: tabular-nums;
    }
    .touch-label {
      display: none;
    }
  }

  @media (min-width: 900px) {
    .contact-card {
      grid-template-columns: 1.2fr 1fr;
      gap: 64px;
    }
  }
  /* Kontaktkarte: leichtes Heranwachsen statt nur Hochschieben */
  .reveal-scale {
    transform: translateY(16px) scale(0.98);
  }

  .reveal-scale.is-visible {
    transform: none;
  }

  /* Pfeil bei „Route planen“ zeigt die Richtung an */
  .arrow {
    display: inline-block;
    transition: transform 200ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .route:hover .arrow {
      transform: translate(2px, -2px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-scale {
      transform: none;
      transition-property: opacity;
    }
  }
</style>
