---
import '../styles/global.css';
import { studio } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${studio.name} – Kosmetikstudio in ${studio.city}`,
  description = `${studio.name}: Kosmetik, Gesichtsbehandlungen, Maniküre und Fußpflege in ${studio.city}. Termine nach Vereinbarung unter ${studio.phone}.`,
} = Astro.props;

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'BeautySalon',
  name: studio.name,
  telephone: studio.phoneHref.replace('tel:', ''),
  address: {
    '@type': 'PostalAddress',
    streetAddress: studio.street,
    postalCode: studio.zip,
    addressLocality: studio.city,
    addressCountry: 'DE',
  },
};
---

<!doctype html>
<html lang="de" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#fbf8f3" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
  </head>
  <body>
    <slot />
    <script>
      const els = document.querySelectorAll<HTMLElement>('.reveal');
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '0px 0px -60px 0px' },
      );
      els.forEach((el) => io.observe(el));
    </script>
  </body>
</html>
